# AIESEC XP - environment.

# --- Database ---------------------------------------------------------------
# DATABASE_URL is the pooled runtime connection. DIRECT_URL is the non-pooled
# connection Prisma migrations need; required on Neon/Supabase, otherwise set
# both to the same value.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- AIESEC OAuth (member login, identity only) -----------------------------
# Base URL; /authorize and /token are appended.
AIESEC_AUTH_URL="https://auth.aiesec.org/oauth"
AIESEC_CLIENT_ID=""
AIESEC_CLIENT_SECRET=""
# Must match a redirect URI registered on the AIESEC OAuth application exactly.
AIESEC_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# --- GIS ---------------------------------------------------------------------
# Not NEXT_PUBLIC_: GIS is never called from the browser.
GIS_GRAPHQL_URL="https://gis-api.aiesec.org/graphql"
# Non-expiring entity-wide service token. Server-only, never logged,
# never serialised to a client payload.
GIS_SERVICE_TOKEN=""

# --- Scope -------------------------------------------------------------------
# Root office of the competition. The subtree is derived from GIS, never
# hardcoded.
MC_OFFICE_ID=""
# Optional. The office id MC-direct's own funnel counts are actually bucketed
# under in the AIESEC analytics API -- a sibling entity in GIS's tree, not
# MC_OFFICE_ID itself (D-56). Leave unset if unknown; MC-direct's office-level
# board then reads zero funnel activity rather than crashing.
MC_DIRECT_ENTITY_ID=""

# --- Secrets -----------------------------------------------------------------
# 32+ bytes. Generate with: openssl rand -base64 32
# Signs the session cookie issued after login.
SESSION_SECRET=""
# Shared secret for /api/cron/*. The GitHub Actions workflows send it as a
# Bearer token, so the repository's CRON_SECRET Actions secret must hold the
# same value.
CRON_SECRET=""

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
