# AIESEC XP - environment.

# --- Database ---------------------------------------------------------------
# DATABASE_URL: pooled runtime connection. DIRECT_URL: non-pooled, for migrations
# (set both to the same value if your host has no pooler).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- AIESEC OAuth (member login, identity only) -----------------------------
# Base URL; /authorize and /token are appended.
AIESEC_AUTH_URL="https://auth.aiesec.org/oauth"
AIESEC_CLIENT_ID=""
AIESEC_CLIENT_SECRET=""
# Must match a redirect URI registered on the AIESEC OAuth application exactly.
AIESEC_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# --- GIS ---------------------------------------------------------------------
# Not NEXT_PUBLIC_: GIS is never called from the browser.
GIS_GRAPHQL_URL="https://gis-api.aiesec.org/graphql"
# Entity-wide service token. Server-only; never log it.
GIS_SERVICE_TOKEN=""

# --- Scope -------------------------------------------------------------------
# Root office of the competition; the subtree is read from GIS.
MC_OFFICE_ID=""
# Optional. The analytics entity MC-direct's funnel counts are bucketed under
# (a sibling of MC_OFFICE_ID). Unset means MC-direct shows zero activity.
MC_DIRECT_ENTITY_ID=""

# --- Secrets -----------------------------------------------------------------
# Signs the session cookie. 32+ bytes: openssl rand -base64 32
SESSION_SECRET=""
# Bearer token for /api/cron/*; must match the CRON_SECRET GitHub Actions secret.
CRON_SECRET=""

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
