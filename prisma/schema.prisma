// Data model for AIESEC XP. The authority for this design is Architecture.md
// section 5; decisions are cited as D-xx and live in Context.md section 3.
//
// Connection URLs live in prisma.config.ts: Prisma 7 no longer accepts url or
// directUrl here. The runtime connection is supplied by a driver adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Org and members ─────────────────────────────────────────────────────────

model Office {
  id          BigInt  @id
  name        String
  parentId    BigInt?
  isMc        Boolean @default(false)
  // D-39. Closed offices stay in the tree so historical events still resolve a
  // name, but their members neither compete nor sign in.
  isOperating Boolean @default(false)

  members         Member[]        @relation("MemberHomeOffice")
  scoringMembers  Member[]        @relation("MemberScoringOffice")

  @@index([parentId])
  @@index([isOperating])
}

model Member {
  id              BigInt   @id // GIS person id, always present at login
  fullName        String
  aiesecEmail     String?
  profilePhotoUrl String?
  homeOfficeId    BigInt?
  // D-32. The office whose LC total this member's points count towards.
  scoringOfficeId BigInt?
  firstSeenAt     DateTime @default(now())
  lastSyncedAt    DateTime @updatedAt

  homeOffice    Office?            @relation("MemberHomeOffice", fields: [homeOfficeId], references: [id], onDelete: SetNull)
  scoringOffice Office?            @relation("MemberScoringOffice", fields: [scoringOfficeId], references: [id], onDelete: SetNull)
  positions     Position[]
  assignments   EpAssignment[]
  sheetMappings SheetManagerMapping[]
  ledgerEntries ScoreLedgerEntry[]
  rewardGrants  RewardGrant[]
  avatar        MemberAvatar?

  @@index([scoringOfficeId])
}

// The member's chosen body and its colours (D-50, closes O-14).
//
// A table of its own rather than columns on Member, because Member is the GIS
// sync projection: its `lastSyncedAt` is `@updatedAt` and means "when GIS last
// confirmed this person", so saving an avatar there would keep reporting a sync
// that never happened.
//
// A null colour means the part keeps the colour it was authored with, which is
// not the same as any hex a member could pick.
model MemberAvatar {
  memberId  BigInt   @id
  character String
  skin      String?
  hair      String?
  shirt     String?
  trouser   String?
  shoe      String?
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Position {
  id        BigInt    @id // GIS member_position id
  memberId  BigInt
  // Not a relation: a member may hold a position in an office outside the 182
  // subtree, which this system never syncs. A foreign key would reject the row.
  officeId  BigInt
  roleName  String?
  title     String?
  status    String // GIS uses "active"; "current" is accepted and matches nothing
  startDate DateTime?
  endDate   DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([officeId, status])
}

// ── EP assignment: who is credited with an EP ───────────────────────────────

// One row per EP and member (D-73). A row can come from several places at once,
// and each automatic source is rewritten by its own sync: EXPA mirrors the EP's
// managers in EXPA (D-74), SHEET the sheet's responsible member (D-77). ADMIN
// is a manual add, which nothing automatic clears. A row counts while any
// source is set and it has not been removed.
model EpAssignment {
  id         String    @id @default(cuid())
  epPersonId BigInt
  memberId   BigInt
  fromExpa   Boolean   @default(false)
  fromSheet  Boolean   @default(false)
  fromAdmin  Boolean   @default(false)
  // The EP's main manager (D-83), picked by an admin: full points while
  // everyone else takes their role's %. Holds the row on the EP whatever EXPA
  // or the sheet later say. At most one per EP, kept by the action that sets it.
  isMain     Boolean   @default(false)
  // An admin removal outranks every source, so the next sync cannot bring the
  // credit back. Kept as a row rather than deleted for exactly that reason.
  removedAt  DateTime?
  removedBy  BigInt?
  createdBy  BigInt
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([epPersonId, memberId])
  @@index([memberId])
}

// The MC's sign-up sheet (D-80). One active row: configuration rather than a
// constant so a new term's sheet is a row change, not a deploy.
model AssignmentSheet {
  id              String    @id @default(cuid())
  label           String
  spreadsheetId   String    @unique
  // Each EP's row: "EP ID", "EP Manager", "LC Assigned To", "Function Assigned to".
  tabName         String
  // The EP managers' directory: "LC", "Team", "EP Manager Name", "EXPA ID".
  managersTabName String    @default("Sheet7")
  isActive        Boolean   @default(true)
  lastImportAt    DateTime?
}

// An EP manager's name in the sheet matched to a member on the console (D-80):
// the same shape as a row of the sheet's directory tab, and preferred over it
// for the same name, LC and team. Keys are normalised; `name`, `lc` and `team`
// keep the spelling the sheet used, for display.
model SheetManagerMapping {
  id        String   @id @default(cuid())
  nameKey   String
  lcKey     String   @default("")
  teamKey   String   @default("")
  name      String
  lc        String   @default("")
  team      String   @default("")
  memberId  BigInt
  createdBy BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([nameKey, lcKey, teamKey])
  @@index([memberId])
}

// ── Raw exchange events from GIS ────────────────────────────────────────────

enum FunnelEvent {
  APL
  APD
  RE
  APD_BROKEN
  RE_BROKEN
}

// What a ledger entry pays for: an event's own stage, or for a break the stage
// it takes back.
enum ScoredStage {
  APL
  APD
  RE
}

enum Direction {
  OUTGOING
  INCOMING
}

// D-42. Scoring facts only. No EP name, no opportunity title, nothing
// descriptive: those are read live from GIS when something is displayed, never
// held here. epPersonId stays because it is the join to EpAssignment, and
// without it no event can be attributed to anyone.
model ExchangeEvent {
  id                  String      @id @default(cuid())
  applicationId       BigInt
  eventType           FunnelEvent
  occurredAt          DateTime
  epPersonId          BigInt // the join key to EpAssignment, and the only EP data held
  programmeId         Int // 7 | 8 | 9
  direction           Direction
  // The application's current status, rewritten on every event of the
  // application whenever its last action moves (D-76). Net APL is a status
  // check rather than a dated reversal, because GIS dates neither withdrawal
  // nor rejection in a filterable way (D-41).
  applicationStatus   String?
  fetchedAt           DateTime    @updatedAt

  ledgerEntries ScoreLedgerEntry[]
  anomalies     ScoringAnomaly[]

  @@unique([applicationId, eventType]) // idempotency key
  @@index([epPersonId, occurredAt])
  @@index([occurredAt])
}

// ── Configuration, versioned, admin-editable ────────────────────────────────

model ScoreConfig {
  id               String   @id @default(cuid())
  version          Int      @unique
  aplPoints        Decimal  @db.Decimal(10, 4)
  apdPoints        Decimal  @db.Decimal(10, 4)
  rePoints         Decimal  @db.Decimal(10, 4)
  // D-41: an application that is withdrawn or rejected does not count. Ships on;
  // configurable so the MC can reverse the decision without a deploy.
  reverseApl       Boolean  @default(true)
  // Which GIS statuses reverse an APL. Config rather than a constant: the
  // observed vocabulary is open, withdrawn, approved, rejected, matched,
  // finished, completed, realized and approval_broken, and GIS may add more.
  aplReversingStatuses Json
  productWeights   Json // { "7": 1, "8": 1, "9": 1 }
  directionWeights Json // { "OUTGOING": 1, "INCOMING": 1 }
  scopeSides       Json // ["PERSON"] today; add "OPPORTUNITY" for incoming (D-27)
  // Percentage of an EP's points each position role takes when more than one
  // member is credited with that EP: { "TM": 40, "TL": 30, ... }, totalling 100
  // (D-73). Rescaled over the roles actually on the EP.
  roleShares       Json     @default("{}")
  isActive         Boolean  @default(false)
  createdBy        BigInt
  createdAt        DateTime @default(now())

  ledgerEntries ScoreLedgerEntry[]

  @@index([isActive])
}

model DisplayWindow {
  id       String    @id @default(cuid())
  label    String
  startsAt DateTime
  endsAt   DateTime?
  isActive Boolean   @default(false)

  @@index([isActive])
}

// The term this system holds data for (D-58). Exactly one row, enforced by a
// check constraint in the migration.
//
// It answers two questions with one date, because for this product they are the
// same date. It is the collection floor, so sync fetches nothing earlier and the
// active DisplayWindow can move without orphaning the history behind it; and it
// is where the leaderboards' date range starts when nobody has picked one.
// Events before it exist in GIS but predate the assignment register, so nothing
// built from them could be attributed to the right member.
model TermSettings {
  id        String   @id @default("singleton")
  startsAt  DateTime
  updatedAt DateTime @updatedAt
}

enum ThresholdType {
  POINTS
  APL_COUNT
  APD_COUNT
  RE_COUNT
}

model Reward {
  id            String        @id @default(cuid())
  label         String
  description   String?
  thresholdType ThresholdType
  threshold     Decimal       @db.Decimal(10, 4)
  valueAmount   Decimal?      @db.Decimal(12, 2)
  valueCurrency String?
  iconKey       String?
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)

  grants RewardGrant[]

  @@index([isActive, sortOrder])
}

enum MatcherField {
  ROLE_NAME
  TITLE
}

// D-14, O-03. role.name = MCVP is deliberately absent: it also matches MXP and
// MKT, which would hand admin to the wrong people.
model AdminMatcher {
  id      String       @id @default(cuid())
  pattern String
  field   MatcherField

  @@unique([field, pattern])
}

// ── Derived, fully recomputable ─────────────────────────────────────────────

model ScoreLedgerEntry {
  id              String      @id @default(cuid())
  memberId        BigInt
  exchangeEventId String
  // Kept on the entry so totals and trails need no join to the event.
  stage           ScoredStage
  configVersion   Int
  points          Decimal     @db.Decimal(12, 4) // negative on break
  // This member's part of the EP's points: 1 for the main or a sole manager,
  // otherwise their role's % (D-83).
  share           Decimal     @default(1) @db.Decimal(7, 6)
  // The same part of the stage's count, negative on a break (D-83).
  countDelta      Decimal     @db.Decimal(7, 6)
  occurredAt      DateTime

  member Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  ExchangeEvent @relation(fields: [exchangeEventId], references: [id], onDelete: Cascade)
  config ScoreConfig   @relation(fields: [configVersion], references: [version], onDelete: Restrict)

  @@unique([memberId, exchangeEventId])
  @@index([memberId, occurredAt])
  @@index([exchangeEventId])
}

// D-34. A replay that no longer supports a grant deletes it; there is no
// REVOKED state, because honouring an announced reward is an MC decision.
model RewardGrant {
  id       String   @id @default(cuid())
  memberId BigInt
  rewardId String
  earnedAt DateTime

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([memberId, rewardId])
  @@index([rewardId])
}

enum AnomalyKind {
  UNKNOWN_PROGRAMME_WEIGHT
  BREAK_WITHOUT_STAGE_EVENT
  UNATTRIBUTED
}

// Events the engine could not score confidently. Derived alongside the ledger
// and rebuilt with it, so an admin queue can be read without running a replay.
model ScoringAnomaly {
  id              String      @id @default(cuid())
  exchangeEventId String
  kind            AnomalyKind
  detail          String?
  createdAt       DateTime    @default(now())

  event ExchangeEvent @relation(fields: [exchangeEventId], references: [id], onDelete: Cascade)

  @@unique([exchangeEventId, kind])
  @@index([kind])
}

// ── Operations ──────────────────────────────────────────────────────────────

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model SyncRun {
  id         String     @id @default(cuid())
  pass       String
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  eventsSeen Int        @default(0)
  status     SyncStatus @default(RUNNING)
  error      String?

  @@index([pass, startedAt])
}

// Advances only on a fully successful pass, and is read back with a 48-hour
// overlap so back-dated records are not missed.
model SyncWatermark {
  pass      String   @id
  watermark DateTime
  updatedAt DateTime @updatedAt
}

enum SyncTrigger {
  HACKATHON
  SCHEDULE
  MANUAL
}

// One row per scheduled job (D-66): "events" and "roster". Every trigger, a
// GitHub schedule or an admin's button, takes the lease before running, so the
// two can never run one job at once. The lease expires by itself, so a run the
// platform killed at its time limit cannot wedge the job.
model SyncJob {
  name            String       @id
  leaseUntil      DateTime?
  lastStartedAt   DateTime?
  lastFinishedAt  DateTime?
  lastSucceededAt DateTime?
  lastStatus      SyncStatus?
  lastTrigger     SyncTrigger?
  lastError       String?
}

// D-66. One row, enforced by a check constraint like TermSettings. Hackathon
// mode is an end time rather than a flag, so a switch nobody remembers to turn
// off lapses back to the daily cadence by itself.
model SyncSettings {
  id             String    @id @default("singleton")
  hackathonUntil DateTime?
  updatedAt      DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    BigInt
  action     String // CONFIG_UPDATE, ASSIGNMENT_SET, MATCH_CONFIRM, IMPORT, REPLAY, EXPORT
  targetType String
  targetId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
