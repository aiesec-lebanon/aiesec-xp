// Prisma 7 takes connection URLs from prisma.config.ts and a driver adapter, not here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Org and members ─────────────────────────────────────────────────────────

model Office {
  id          BigInt  @id
  name        String
  parentId    BigInt?
  isMc        Boolean @default(false)
  // Closed offices stay so historical events resolve a name; their members neither compete nor sign in.
  isOperating Boolean @default(false)

  members         Member[]        @relation("MemberHomeOffice")
  scoringMembers  Member[]        @relation("MemberScoringOffice")

  @@index([parentId])
  @@index([isOperating])
}

model Member {
  id              BigInt   @id // GIS person id, always present at login
  fullName        String
  aiesecEmail     String?
  profilePhotoUrl String?
  homeOfficeId    BigInt?
  // The office whose LC total this member's points count towards.
  scoringOfficeId BigInt?
  firstSeenAt     DateTime @default(now())
  lastSyncedAt    DateTime @updatedAt

  homeOffice    Office?            @relation("MemberHomeOffice", fields: [homeOfficeId], references: [id], onDelete: SetNull)
  scoringOffice Office?            @relation("MemberScoringOffice", fields: [scoringOfficeId], references: [id], onDelete: SetNull)
  positions     Position[]
  assignments   EpAssignment[]
  sheetMappings SheetManagerMapping[]
  ledgerEntries ScoreLedgerEntry[]
  rewardGrants  RewardGrant[]
  avatar        MemberAvatar?

  @@index([scoringOfficeId])
}

// Separate from Member, whose @updatedAt `lastSyncedAt` would misreport an avatar save as a sync.
// A null colour keeps the authored colour.
model MemberAvatar {
  memberId  BigInt   @id
  character String
  skin      String?
  hair      String?
  shirt     String?
  trouser   String?
  shoe      String?
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Position {
  id        BigInt    @id // GIS member_position id
  memberId  BigInt
  // Not a relation: a member may hold a position in an office outside the 182
  // subtree, which this system never syncs. A foreign key would reject the row.
  officeId  BigInt
  roleName  String?
  title     String?
  status    String // GIS uses "active"; "current" is accepted and matches nothing
  startDate DateTime?
  endDate   DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([officeId, status])
}

// ── EP assignment: who is credited with an EP ───────────────────────────────

// One row per EP and member. Each automatic source (EXPA, SHEET) is rewritten by its own
// sync; ADMIN is never cleared automatically. Counts while any source is set and not removed.
model EpAssignment {
  id         String    @id @default(cuid())
  epPersonId BigInt
  memberId   BigInt
  fromExpa   Boolean   @default(false)
  fromSheet  Boolean   @default(false)
  fromAdmin  Boolean   @default(false)
  // Full points while others take their role's %. Survives EXPA/sheet changes.
  // At most one per EP, enforced by the action that sets it.
  isMain     Boolean   @default(false)
  // Kept as a row, not deleted, so the next sync cannot bring the credit back.
  removedAt  DateTime?
  removedBy  BigInt?
  createdBy  BigInt
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([epPersonId, memberId])
  @@index([memberId])
}

// One active row, so a new term's sheet is a row change rather than a deploy.
model AssignmentSheet {
  id              String    @id @default(cuid())
  label           String
  spreadsheetId   String    @unique
  // Each EP's row: "EP ID", "EP Manager", "LC Assigned To", "Function Assigned to".
  tabName         String
  // The EP managers' directory: "LC", "Team", "EP Manager Name", "EXPA ID".
  managersTabName String    @default("Sheet7")
  isActive        Boolean   @default(true)
  lastImportAt    DateTime?
}

// Preferred over the sheet's directory tab for the same name, LC and team.
// Keys are normalised; `name`, `lc` and `team` keep the sheet's spelling for display.
model SheetManagerMapping {
  id        String   @id @default(cuid())
  nameKey   String
  lcKey     String   @default("")
  teamKey   String   @default("")
  name      String
  lc        String   @default("")
  team      String   @default("")
  memberId  BigInt
  createdBy BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([nameKey, lcKey, teamKey])
  @@index([memberId])
}

// ── Raw exchange events from GIS ────────────────────────────────────────────

enum FunnelEvent {
  APL
  APD
  RE
  APD_BROKEN
  RE_BROKEN
}

// For a break, the stage it takes back.
enum ScoredStage {
  APL
  APD
  RE
}

enum Direction {
  OUTGOING
  INCOMING
}

// Scoring facts only: nothing descriptive about the EP is stored; it is read live from GIS.
model ExchangeEvent {
  id                  String      @id @default(cuid())
  applicationId       BigInt
  eventType           FunnelEvent
  occurredAt          DateTime
  epPersonId          BigInt // the join key to EpAssignment, and the only EP data held
  programmeId         Int // 7 | 8 | 9
  direction           Direction
  // Rewritten whenever the application's last action moves. Net APL checks status
  // because GIS doesn't date withdrawal or rejection filterably.
  applicationStatus   String?
  fetchedAt           DateTime    @updatedAt

  ledgerEntries ScoreLedgerEntry[]
  anomalies     ScoringAnomaly[]

  @@unique([applicationId, eventType]) // idempotency key
  @@index([epPersonId, occurredAt])
  @@index([occurredAt])
}

// ── Configuration, versioned, admin-editable ────────────────────────────────

model ScoreConfig {
  id               String   @id @default(cuid())
  version          Int      @unique
  aplPoints        Decimal  @db.Decimal(10, 4)
  apdPoints        Decimal  @db.Decimal(10, 4)
  rePoints         Decimal  @db.Decimal(10, 4)
  // Withdrawn or rejected applications don't count; switchable without a deploy.
  reverseApl       Boolean  @default(true)
  // Which GIS statuses reverse an APL; config because GIS's status vocabulary is open.
  aplReversingStatuses Json
  productWeights   Json // { "7": 1, "8": 1, "9": 1 }
  directionWeights Json // { "OUTGOING": 1, "INCOMING": 1 }
  scopeSides       Json // ["PERSON"]; add "OPPORTUNITY" for incoming
  // { "TM": 40, "TL": 30, ... } totalling 100; rescaled over the roles actually on the EP.
  roleShares       Json     @default("{}")
  isActive         Boolean  @default(false)
  createdBy        BigInt
  createdAt        DateTime @default(now())

  ledgerEntries ScoreLedgerEntry[]
  windows       DisplayWindow[]

  @@index([isActive])
}

// A past period's configVersion never changes; where periods overlap, the newest createdAt wins.
model DisplayWindow {
  id            String    @id @default(cuid())
  label         String
  startsAt      DateTime
  endsAt        DateTime?
  isActive      Boolean   @default(false)
  configVersion Int
  createdAt     DateTime  @default(now())

  config ScoreConfig @relation(fields: [configVersion], references: [version], onDelete: Restrict)

  @@index([isActive])
  @@index([configVersion])
}

// Exactly one row (check constraint in the migration). The start is both the sync floor
// and the leaderboards' default range start; earlier events predate the assignment register.
model TermSettings {
  id        String   @id @default("singleton")
  startsAt  DateTime
  updatedAt DateTime @updatedAt
}

enum ThresholdType {
  POINTS
  APL_COUNT
  APD_COUNT
  RE_COUNT
}

model Reward {
  id            String        @id @default(cuid())
  label         String
  description   String?
  thresholdType ThresholdType
  threshold     Decimal       @db.Decimal(10, 4)
  valueAmount   Decimal?      @db.Decimal(12, 2)
  valueCurrency String?
  iconKey       String?
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)

  grants RewardGrant[]

  @@index([isActive, sortOrder])
}

enum MatcherField {
  ROLE_NAME
  TITLE
}

// role.name = MCVP is deliberately absent: it also matches MXP and MKT.
model AdminMatcher {
  id      String       @id @default(cuid())
  pattern String
  field   MatcherField

  @@unique([field, pattern])
}

// ── Derived, fully recomputable ─────────────────────────────────────────────

model ScoreLedgerEntry {
  id              String      @id @default(cuid())
  memberId        BigInt
  exchangeEventId String
  // Kept on the entry so totals and trails need no join to the event.
  stage           ScoredStage
  configVersion   Int
  points          Decimal     @db.Decimal(12, 4) // negative on break
  // 1 for the main or a sole manager, otherwise their role's %.
  share           Decimal     @default(1) @db.Decimal(7, 6)
  // The same part of the stage's count, negative on a break.
  countDelta      Decimal     @db.Decimal(7, 6)
  occurredAt      DateTime

  member Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  ExchangeEvent @relation(fields: [exchangeEventId], references: [id], onDelete: Cascade)
  config ScoreConfig   @relation(fields: [configVersion], references: [version], onDelete: Restrict)

  @@unique([memberId, exchangeEventId])
  @@index([memberId, occurredAt])
  @@index([exchangeEventId])
}

// A replay that no longer supports a grant deletes it; no REVOKED state, since honouring
// an announced reward is an MC decision.
model RewardGrant {
  id       String   @id @default(cuid())
  memberId BigInt
  rewardId String
  earnedAt DateTime

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([memberId, rewardId])
  @@index([rewardId])
}

enum AnomalyKind {
  UNKNOWN_PROGRAMME_WEIGHT
  BREAK_WITHOUT_STAGE_EVENT
  UNATTRIBUTED
}

// Rebuilt with the ledger, so the admin queue can be read without running a replay.
model ScoringAnomaly {
  id              String      @id @default(cuid())
  exchangeEventId String
  kind            AnomalyKind
  detail          String?
  createdAt       DateTime    @default(now())

  event ExchangeEvent @relation(fields: [exchangeEventId], references: [id], onDelete: Cascade)

  @@unique([exchangeEventId, kind])
  @@index([kind])
}

// ── Operations ──────────────────────────────────────────────────────────────

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model SyncRun {
  id         String     @id @default(cuid())
  pass       String
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  eventsSeen Int        @default(0)
  status     SyncStatus @default(RUNNING)
  error      String?

  @@index([pass, startedAt])
}

// Advances only on a fully successful pass, and is read back with a 48-hour
// overlap so back-dated records are not missed.
model SyncWatermark {
  pass      String   @id
  watermark DateTime
  updatedAt DateTime @updatedAt
}

enum SyncTrigger {
  HACKATHON
  SCHEDULE
  MANUAL
}

// Every trigger takes the lease before running; it expires by itself so a killed run can't wedge the job.
model SyncJob {
  name            String       @id
  leaseUntil      DateTime?
  lastStartedAt   DateTime?
  lastFinishedAt  DateTime?
  lastSucceededAt DateTime?
  lastStatus      SyncStatus?
  lastTrigger     SyncTrigger?
  lastError       String?
}

// One row (check constraint). Hackathon mode is an end time, so a forgotten switch lapses by itself.
model SyncSettings {
  id             String    @id @default("singleton")
  hackathonUntil DateTime?
  updatedAt      DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    BigInt
  action     String // CONFIG_UPDATE, ASSIGNMENT_SET, MATCH_CONFIRM, IMPORT, REPLAY, EXPORT
  targetType String
  targetId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
