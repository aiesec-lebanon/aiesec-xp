// Data model for AIESEC XP. The authority for this design is Architecture.md
// section 5; decisions are cited as D-xx and live in Context.md section 3.
//
// Connection URLs live in prisma.config.ts: Prisma 7 no longer accepts url or
// directUrl here. The runtime connection is supplied by a driver adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Org and members ─────────────────────────────────────────────────────────

model Office {
  id          BigInt  @id
  name        String
  parentId    BigInt?
  isMc        Boolean @default(false)
  // D-39. Closed offices stay in the tree so historical events still resolve a
  // name, but their members neither compete nor sign in.
  isOperating Boolean @default(false)

  members         Member[]        @relation("MemberHomeOffice")
  scoringMembers  Member[]        @relation("MemberScoringOffice")

  @@index([parentId])
  @@index([isOperating])
}

model Member {
  id              BigInt   @id // GIS person id, always present at login
  fullName        String
  aiesecEmail     String?
  profilePhotoUrl String?
  homeOfficeId    BigInt?
  // D-32. The office whose LC total this member's points count towards.
  scoringOfficeId BigInt?
  firstSeenAt     DateTime @default(now())
  lastSyncedAt    DateTime @updatedAt

  homeOffice    Office?            @relation("MemberHomeOffice", fields: [homeOfficeId], references: [id], onDelete: SetNull)
  scoringOffice Office?            @relation("MemberScoringOffice", fields: [scoringOfficeId], references: [id], onDelete: SetNull)
  positions     Position[]
  assignments   EpAssignment[]
  managerAliases ManagerAlias[]
  ledgerEntries ScoreLedgerEntry[]
  rewardGrants  RewardGrant[]
  avatar        MemberAvatar?

  @@index([scoringOfficeId])
}

// The member's chosen body and its colours (D-50, closes O-14).
//
// A table of its own rather than columns on Member, because Member is the GIS
// sync projection: its `lastSyncedAt` is `@updatedAt` and means "when GIS last
// confirmed this person", so saving an avatar there would keep reporting a sync
// that never happened.
//
// A null colour means the part keeps the colour it was authored with, which is
// not the same as any hex a member could pick.
model MemberAvatar {
  memberId  BigInt   @id
  character String
  skin      String?
  hair      String?
  shirt     String?
  trouser   String?
  shoe      String?
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Position {
  id        BigInt    @id // GIS member_position id
  memberId  BigInt
  // Not a relation: a member may hold a position in an office outside the 182
  // subtree, which this system never syncs. A foreign key would reject the row.
  officeId  BigInt
  roleName  String?
  title     String?
  status    String // GIS uses "active"; "current" is accepted and matches nothing
  startDate DateTime?
  endDate   DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([officeId, status])
}

// ── EP assignment: imported from the MC's sheet, not decided here ───────────

// D-44, O-08. The sheet carries the EXPA person id, so every imported row
// resolves exactly and there is no pending or review state to model. A row that
// cannot be resolved is an import error, reported per row, never a stored
// half-assignment.
enum AssignmentSource {
  SHEET
  ADMIN
}

model EpAssignment {
  id            String           @id @default(cuid())
  epPersonId    BigInt
  memberId      BigInt
  effectiveFrom DateTime
  effectiveTo   DateTime? // null = still current (D-36)
  // An ADMIN row is a deliberate correction and survives re-import; a SHEET row
  // is replaced by whatever the sheet says next.
  source        AssignmentSource @default(SHEET)
  createdBy     BigInt
  createdAt     DateTime         @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([epPersonId, effectiveFrom])
  @@index([epPersonId, effectiveFrom])
  @@index([memberId])
}

// Where the assignment register is imported from. Configuration rather than a
// constant: the MC keeps more than one sheet and they change between terms.
model AssignmentSheet {
  id            String   @id @default(cuid())
  label         String
  spreadsheetId String   @unique
  tabName       String
  isActive      Boolean  @default(true)
  lastImportAt  DateTime?
}

// The sheet names a manager by first name, not by id: "Joseph", "Ahmad M",
// "Ahmad K". Those labels are a human convention and cannot be matched to a
// person reliably, so an admin maps each one to a member once, and the import
// refuses any label it has not been told about rather than guessing.
model ManagerAlias {
  label    String @id
  memberId BigInt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// ── Raw exchange events from GIS ────────────────────────────────────────────

enum FunnelEvent {
  APL
  APD
  RE
  APD_BROKEN
  RE_BROKEN
}

enum Direction {
  OUTGOING
  INCOMING
}

// D-42. Scoring facts only. No EP name, no opportunity title, nothing
// descriptive: those are read live from GIS when something is displayed, never
// held here. epPersonId stays because it is the join to EpAssignment, and
// without it no event can be attributed to anyone.
model ExchangeEvent {
  id                  String      @id @default(cuid())
  applicationId       BigInt
  eventType           FunnelEvent
  occurredAt          DateTime
  epPersonId          BigInt // the join key to EpAssignment, and the only EP data held
  programmeId         Int // 7 | 8 | 9
  direction           Direction
  // Current observed state, refreshed by sync pass 5b. Net APL is a status
  // check rather than a dated reversal, because GIS dates neither withdrawal
  // nor rejection in a filterable way (D-41).
  applicationStatus   String?
  fetchedAt           DateTime    @updatedAt

  ledgerEntries ScoreLedgerEntry[]
  anomalies     ScoringAnomaly[]

  @@unique([applicationId, eventType]) // idempotency key
  @@index([epPersonId, occurredAt])
  @@index([occurredAt])
}

// ── Configuration, versioned, admin-editable ────────────────────────────────

model ScoreConfig {
  id               String   @id @default(cuid())
  version          Int      @unique
  aplPoints        Decimal  @db.Decimal(10, 4)
  apdPoints        Decimal  @db.Decimal(10, 4)
  rePoints         Decimal  @db.Decimal(10, 4)
  // D-41: an application that is withdrawn or rejected does not count. Ships on;
  // configurable so the MC can reverse the decision without a deploy.
  reverseApl       Boolean  @default(true)
  // Which GIS statuses reverse an APL. Config rather than a constant: the
  // observed vocabulary is open, withdrawn, approved, rejected, matched,
  // finished, completed, realized and approval_broken, and GIS may add more.
  aplReversingStatuses Json
  productWeights   Json // { "7": 1, "8": 1, "9": 1 }
  directionWeights Json // { "OUTGOING": 1, "INCOMING": 1 }
  scopeSides       Json // ["PERSON"] today; add "OPPORTUNITY" for incoming (D-27)
  isActive         Boolean  @default(false)
  createdBy        BigInt
  createdAt        DateTime @default(now())

  ledgerEntries ScoreLedgerEntry[]

  @@index([isActive])
}

model DisplayWindow {
  id       String    @id @default(cuid())
  label    String
  startsAt DateTime
  endsAt   DateTime?
  isActive Boolean   @default(false)

  @@index([isActive])
}

// The term this system holds data for (D-58). Exactly one row, enforced by a
// check constraint in the migration.
//
// It answers two questions with one date, because for this product they are the
// same date. It is the collection floor, so sync fetches nothing earlier and the
// active DisplayWindow can move without orphaning the history behind it; and it
// is where the leaderboards' date range starts when nobody has picked one.
// Events before it exist in GIS but predate the assignment register, so nothing
// built from them could be attributed to the right member.
model TermSettings {
  id        String   @id @default("singleton")
  startsAt  DateTime
  updatedAt DateTime @updatedAt
}

enum ThresholdType {
  POINTS
  APL_COUNT
  APD_COUNT
  RE_COUNT
}

model Reward {
  id            String        @id @default(cuid())
  label         String
  description   String?
  thresholdType ThresholdType
  threshold     Decimal       @db.Decimal(10, 4)
  valueAmount   Decimal?      @db.Decimal(12, 2)
  valueCurrency String?
  iconKey       String?
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)

  grants RewardGrant[]

  @@index([isActive, sortOrder])
}

enum MatcherField {
  ROLE_NAME
  TITLE
}

// D-14, O-03. role.name = MCVP is deliberately absent: it also matches MXP and
// MKT, which would hand admin to the wrong people.
model AdminMatcher {
  id      String       @id @default(cuid())
  pattern String
  field   MatcherField

  @@unique([field, pattern])
}

// ── Derived, fully recomputable ─────────────────────────────────────────────

model ScoreLedgerEntry {
  id              String   @id @default(cuid())
  memberId        BigInt
  exchangeEventId String
  configVersion   Int
  points          Decimal  @db.Decimal(12, 4) // negative on break
  countDelta      Int
  occurredAt      DateTime

  member Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  ExchangeEvent @relation(fields: [exchangeEventId], references: [id], onDelete: Cascade)
  config ScoreConfig   @relation(fields: [configVersion], references: [version], onDelete: Restrict)

  @@unique([memberId, exchangeEventId])
  @@index([memberId, occurredAt])
  @@index([exchangeEventId])
}

// D-34. A replay that no longer supports a grant deletes it; there is no
// REVOKED state, because honouring an announced reward is an MC decision.
model RewardGrant {
  id       String   @id @default(cuid())
  memberId BigInt
  rewardId String
  earnedAt DateTime

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([memberId, rewardId])
  @@index([rewardId])
}

enum AnomalyKind {
  UNKNOWN_PROGRAMME_WEIGHT
  BREAK_WITHOUT_STAGE_EVENT
  UNATTRIBUTED
}

// Events the engine could not score confidently. Derived alongside the ledger
// and rebuilt with it, so an admin queue can be read without running a replay.
model ScoringAnomaly {
  id              String      @id @default(cuid())
  exchangeEventId String
  kind            AnomalyKind
  detail          String?
  createdAt       DateTime    @default(now())

  event ExchangeEvent @relation(fields: [exchangeEventId], references: [id], onDelete: Cascade)

  @@unique([exchangeEventId, kind])
  @@index([kind])
}

// ── Operations ──────────────────────────────────────────────────────────────

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model SyncRun {
  id         String     @id @default(cuid())
  pass       String
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  eventsSeen Int        @default(0)
  status     SyncStatus @default(RUNNING)
  error      String?

  @@index([pass, startedAt])
}

// Advances only on a fully successful pass, and is read back with a 48-hour
// overlap so back-dated records are not missed.
model SyncWatermark {
  pass      String   @id
  watermark DateTime
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    BigInt
  action     String // CONFIG_UPDATE, ASSIGNMENT_SET, MATCH_CONFIRM, IMPORT, REPLAY, EXPORT
  targetType String
  targetId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
