# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env: the example is the one file that ships
!.env.example

# spike output contains real GIS data (EP names, emails)
/scripts/spike/out/

# vendored agent skills, restorable from skills-lock.json
/.agents/

# scratch downloads: sheet exports contain EP personal data
/.tmp/

# vendor 3D assets, regenerated from node_modules by postinstall
/public/draco/
/public/hdri/
/public/fonts/

# Blender authoring files: tens of MB of packed source textures, and the
# pipeline's tracked input is the exported .glb (assets/README.md), not these.
*.blend
*.blend[0-9]

ref/
.claude/
