{
  "name": "aiesec-xp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "postinstall": "prisma generate && node scripts/assets/sync-vendor-assets.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "gis:schema": "node scripts/gis-schema.mjs",
    "gis:codegen": "graphql-codegen",
    "gis:spike": "node scripts/spike/run.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:vendor": "node scripts/assets/sync-vendor-assets.mjs",
    "assets:models": "tsx scripts/assets/optimize-gltf.mts"
  },
  "dependencies": {
    "@pmndrs/assets": "^1.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/rapier": "^2.2.0",
    "graphql-request": "^7.4.0",
    "motion": "^13.2.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "three": "^0.186.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "graphql": "^16.14.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.8"
  }
